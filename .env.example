# SimplyApply configuration.
# Everything here is optional — the app boots without it and you can set the same
# values from the Settings page in the UI, which writes them to the local SQLite DB.
#
# Values set here act as defaults on first boot. Keys never leave your machine.

# --- Storage ---------------------------------------------------------------
# Where the SQLite file and generated resume artifacts live.
SIMPLYAPPLY_DATA_DIR=./data

# --- LLM provider ----------------------------------------------------------
# One of: anthropic | openai | ollama
# You can leave this alone and pick a provider in the app's setup card instead.
SIMPLYAPPLY_LLM_PROVIDER=anthropic

# Used when provider is anthropic
ANTHROPIC_API_KEY=
SIMPLYAPPLY_ANTHROPIC_MODEL=claude-sonnet-5

# Used when provider is openai. Also works for any OpenAI-compatible endpoint
# (Groq, Together, OpenRouter, LM Studio) by overriding the base URL.
OPENAI_API_KEY=
SIMPLYAPPLY_OPENAI_MODEL=gpt-4o
SIMPLYAPPLY_OPENAI_BASE_URL=https://api.openai.com/v1

# Used when provider is ollama. No key required.
SIMPLYAPPLY_OLLAMA_HOST=http://localhost:11434
SIMPLYAPPLY_OLLAMA_MODEL=qwen2.5:7b

# --- Search ----------------------------------------------------------------
# How long cached postings stay fresh before a source is re-queried.
SIMPLYAPPLY_CACHE_TTL_MINUTES=60

# --- Extension auth ----------------------------------------------------------
# Shared secret the browser extension (and, in Docker Compose, the frontend's proxy)
# must send as X-SimplyApply-Token on every endpoint an extension calls. Leave this
# blank and the backend generates one on first startup and logs it — copy that value
# here (and restart both services) if you want the frontend's own /api/* proxy to keep
# working without a second manual step. Required for Compose since the frontend
# container can't read the backend's auto-generated value out of its private volume.
SIMPLYAPPLY_EXTENSION_TOKEN=
